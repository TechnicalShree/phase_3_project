# demo is deterministic and makes no model calls; live requires a key.
MODEL_MODE=demo
LLM_PROVIDER=commandcode_cli
CMD_API_KEY=
CMD_MODEL=stealth/space-bunny-alpha
# Optional: absolute executable path if CLI is not installed in .venv/commandcode.
CMD_CLI_PATH=
# Optional alternative: set LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
DATA_DIR=data
# Optional for loopback-only use; required before remote access. Use a long random token.
API_TOKEN=

# Enable automatic, isolated visitor sessions; requires API_TOKEN.
PUBLIC_GUEST_ACCESS=0
