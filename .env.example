# demo is deterministic and makes no model calls; live requires a key.
MODEL_MODE=demo
LLM_PROVIDER=commandcode
CMD_API_KEY=
CMD_MODEL=gpt-5.4-mini
# Optional alternative: set LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
DATA_DIR=data
# Optional for loopback-only use; required before remote access. Use a long random token.
API_TOKEN=
